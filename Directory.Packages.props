<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions are floating per major (Major.*); CPM rejects floating ranges unless this is enabled. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.*" />
    <PackageVersion Include="YamlDotNet" Version="18.*" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.MTP" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageVersion Include="Shouldly" Version="4.*" />
    <PackageVersion Include="xunit.v3" Version="4.*" />
  </ItemGroup>

</Project>
