<Project>

  <PropertyGroup>
    <!-- The version of pusula. The server reports it without the commit that the SDK adds after a '+' (see Startup/AppVersion.cs). -->
    <Version>0.1.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Warnings fail the build in CI (CI=true, which GitHub Actions sets), not for someone who only wants to run pusula:
         a newer SDK or a new advisory for a package would stop `dotnet run` there. Locally: dotnet build -warnaserror. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

</Project>
